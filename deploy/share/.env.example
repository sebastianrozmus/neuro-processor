# Domain pointing at this host (A/AAAA record); Caddy gets the certificate.
SHARE_DOMAIN=share.example.org
# Optional extra secret mixed into the challenge key (openssl rand -hex 32).
# Each start adds random bytes of its own anyway.
SHARE_SECRET=
# Proof of work in leading zero bits (1..32): 20 is about 1 s on a laptop.
SHARE_DIFFICULTY=20
# Submissions per installation per day; all submissions per day; bytes.
SHARE_PER_KEY_DAY=200
SHARE_PER_DAY=20000
SHARE_PER_DAY_MB=200
# Disk the data may take in all; above it the server answers "busy".
SHARE_TOTAL_MB=5120
# Model names the game ships, comma separated; others are flagged.
SHARE_MODELS=
